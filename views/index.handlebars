<div class="container">
  <div class="jumbotron">
    <h1>Veggie Burgers</h1>
  </div>



  {{!-- Burger Columns --}}
  <div class="row">
    <div class="col-md-6">
      <h4>Burgers Ready to Eat</h4>
      <ul>

        {{#each burger}}
        {{#unless devoured}}
        <p>
          {{> burgers/burger-block devoured=true}}
        </p>
        {{/unless}}
        {{/each}}
      </ul>
    </div>
    <div class="col-md-6">
      <h4>Burgers Previously eaten</h4>
      <ul>
        {{#each burger}}
        {{#if devoured}}
        {{> burgers/burger-block devoured=false}}
        {{/if}}
        {{/each}}
      </ul>
    </div>
  </div>

  {{!-- ADD A BURGER --}}
  <div class="row">
    <div class="col-md-12" align="center">

      <h3>Add a burger</h3>
      <h5>
        {{#each burgers}}
        <li>Hello, {{burger.burger_name}}!</li>
        {{/each}}
      </h5>
      <form class="create-form">

        <div class="form-group">
          <label for="burgerName">Burger Name:</label>
          <input type="text" id="burgerName" name="name">
        </div>

        <div class="form-group">
          <label for="devored">Did you already eat it?</label><br>
          <input type="radio" name="devoured" value="1" checked> No, thanks!<br>
          <input type="radio" name="devoured" value="0"> Yum!
        </div>
        <button type="submit">Add Burger</button>
      </form>





    </div>
  </div class="footer-margin">
  <footer class="footer">
    <div class="container">
      <span class="text">&copy; 2018 zzzbray</span>
    </div>
  </footer>
</div>